+import { Injectable } from '@angular/core';
+import { FileApiService } from '@angular-workspace/services';
+import {
+  EncryptedUploadService,
+  InitiatedUpload,
+} from './encrypted-upload.service';
+import type { EncryptionSession } from '../../../lib/encrypted-dataset-upload';
+
+/** Files uploading at the same time. Small files are bound by round trips, not bandwidth. */
+export const FILE_UPLOAD_CONCURRENCY = 6;
+/** Single-part files initiated per request (POST /uploads/batch accepts up to 100). */
+export const INITIATE_BATCH_SIZE = 20;
+
+export interface DatasetUploadItem {
+  file: File;
+  /** Object key relative to the databank (already version-prefixed where needed) */
+  key: string;
+}
+
+/** Callbacks get back the caller's own item objects, so extra fields (e.g. the UI row) ride along. */
+export interface DatasetUploadCallbacks<
+  T extends DatasetUploadItem = DatasetUploadItem,
+> {
+  /** The file's upload started (its URLs are ready) */
+  onStart?: (item: T) => void;
+  /** 0–100 for one file */
+  onProgress?: (item: T, pct: number) => void;
+  /** The file is stored. `uploadId` is set for multipart uploads (needed to cancel), `previewData` for plain uploads. */
+  onDone?: (item: T, result: { uploadId?: string; previewData?: any }) => void;
+  onError?: (item: T, error: unknown) => void;
+}
+
+export interface DatasetUploadOptions {
+  /** Client-side encryption (environment.encryptedDatasetUpload) */
+  encrypted: boolean;
+  /** Plain uploads: ask the server for a preview of each file after it is stored */
+  preview: boolean;
+}
+
+/** A file whose upload URLs are ready (or whose initiation failed). */
+interface ReadyFile<T extends DatasetUploadItem> {
+  item: T;
+  numParts: number;
+  upload?: InitiatedUpload;
+  error?: unknown;
+}
+
+/**
+ * Uploads a set of dataset files to one databank, shared by the onboarding
+ * "Upload files" step and the "Manage files" modal:
+ *
+ * - FILE_UPLOAD_CONCURRENCY files upload at the same time (it used to be one).
+ * - Files that fit in one part are initiated INITIATE_BATCH_SIZE at a time
+ *   with one request, as direct uploads: one presigned PUT straight to the
+ *   final object, with no complete call. The next batch is initiated while the
+ *   current one uploads. Larger files are initiated one by one as multipart.
+ * - The file list is not refreshed after every file; callers refresh once
+ *   when uploadFiles() resolves.
+ * - Encrypted: one encryption session for the whole call; its manifest is
+ *   written after the last file (EncryptedUploadService.finishSession).
+ * - Plain: one whole-file PUT, complete (unless direct), then the preview.
+ *
+ * Per-file failures are reported through onError and do not stop the others.
+ */
+@Injectable({ providedIn: 'root' })
+export class DatasetUploadService {
+  constructor(
+    private fileApiService: FileApiService,
+    private encryptedUploadService: EncryptedUploadService,
+  ) {}
+
+  async uploadFiles<T extends DatasetUploadItem>(
+    databankId: string,
+    items: T[],
+    options: DatasetUploadOptions,
+    callbacks: DatasetUploadCallbacks<T> = {},
+  ): Promise<void> {
+    if (items.length === 0) {
+      return;
+    }
+    const session = options.encrypted
+      ? await this.encryptedUploadService.startSession()
+      : null;
+    const numParts = (file: File) =>
+      options.encrypted ? this.encryptedUploadService.partCount(file) : 1;
+
+    // Single-part files go in batches; each multipart file is its own "batch".
+    const batches: T[][] = [];
+    let small: T[] = [];
+    for (const item of items) {
+      if (numParts(item.file) > 1) {
+        batches.push([item]);
+      } else {
+        small.push(item);
+        if (small.length === INITIATE_BATCH_SIZE) {
+          batches.push(small);
+          small = [];
+        }
+      }
+    }
+    if (small.length) {
+      batches.push(small);
+    }
+
+    // Workers pull initiated files from one stream; the stream initiates the
+    // next batch while the workers upload the current one.
+    const initiateBatch = (batch: T[]) =>
+      this.initiate(databankId, batch, numParts);
+    async function* readyFiles(): AsyncGenerator<ReadyFile<T>> {
+      let next: Promise<ReadyFile<T>[]> | null = initiateBatch(batches[0]);
+      for (let b = 0; next; b++) {
+        const ready: ReadyFile<T>[] = await next;
+        next = b + 1 < batches.length ? initiateBatch(batches[b + 1]) : null;
+        yield* ready;
+      }
+    }
+    const stream = readyFiles();
+    const worker = async () => {
+      for (let r = await stream.next(); !r.done; r = await stream.next()) {
+        await this.uploadOne(databankId, r.value, session, options, callbacks);
+      }
+    };
+    await Promise.all(
+      Array.from(
+        { length: Math.min(FILE_UPLOAD_CONCURRENCY, items.length) },
+        worker,
+      ),
+    );
+
+    if (session) {
+      await this.encryptedUploadService.finishSession(databankId, session);
+    }
+  }
+
